include LICENSE CITATION.cff THIRD_PARTY_NOTICES.md README.zh-CN.md CHANGELOG.md
recursive-include docs *.md
recursive-include examples *.json *.xyz *.template
recursive-include environment *.txt *.yml
recursive-include tools *.py
recursive-include benchmarks *.csv *.json
recursive-include tests *.py
include .github/workflows/tests.yml
include .gitattributes .gitignore
global-exclude *.pyc
prune runs
prune validation
